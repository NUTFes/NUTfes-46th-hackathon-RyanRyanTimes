{
  "name": "ryanryan-times-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply times-local --local",
    "db:seed": "tsx scripts/seed.ts",
    "import:slack": "tsx scripts/pipeline.ts import:slack",
    "import:github": "tsx scripts/pipeline.ts import:github",
    "members:sync": "tsx scripts/pipeline.ts members:sync",
    "aggregate": "tsx scripts/pipeline.ts aggregate",
    "seeds": "tsx scripts/pipeline.ts seeds",
    "drafts": "tsx scripts/pipeline.ts drafts",
    "drafts:regenerate": "tsx scripts/pipeline.ts drafts:regenerate",
    "cleanup": "tsx scripts/pipeline.ts cleanup",
    "monthly": "tsx scripts/pipeline.ts monthly",
    "pipeline:fixtures": "tsx scripts/pipeline-fixtures.ts",
    "pipeline:verify": "tsx scripts/verify-pipeline.ts",
    "smoke:dev": "tsx scripts/dev-smoke.ts"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@opennextjs/cloudflare": "^1.0.0",
    "drizzle-orm": "^0.44.0",
    "html-to-image": "^1.11.13",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13",
    "wrangler": "^4.0.0"
  }
}
